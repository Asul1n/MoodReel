# MoodReel 后端配置示例：复制为 .env 后填写
# SQLite 数据库文件路径（默认 backend/data/moodreel.db）
MOODREEL_DB=./data/moodreel.db

# 模型目录（训练产物 vocab.json / textcnn.npz 放在这里）
MOODREEL_MODEL_DIR=./models

# DeepSeek 大模型情感分析（OpenAI 兼容；唯一中文通道，platform.deepseek.com 申请 Key）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_ENABLED=false

# 豆瓣反爬池（可选；默认匿名单会话、单线程）
# DOUBAN_COOKIES=   # 每行一个账号的 Cookie 字符串（多个则轮换）
# DOUBAN_PROXIES=   # 每行一个代理，如 http://user:pass@ip:port
# DOUBAN_WORKERS=1  # 并发数（默认 1，低调；调大前请评估被封风险）

# 监听地址
HOST=0.0.0.0
PORT=8000

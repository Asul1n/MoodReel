# MoodReel 后端配置示例：复制为 .env 后填写
# SQLite 数据库文件路径（默认 backend/data/moodreel.db）
MOODREEL_DB=./data/moodreel.db

# 模型目录（训练产物 vocab.json / textcnn.npz 放在这里）
MOODREEL_MODEL_DIR=./models

# 百度 AI 情感倾向分析 API（可选中文通道，按需开通。百度智能云「情感倾向分析」填 AK/SK）
# 注：收费 API，默认关闭；当前中文分析优先走本地模型/星级，需要云时才打开。
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
BAIDU_ENABLED=false

# 腾讯 AI 情感分析 API（备选中文通道；当前路由已改用百度）
TENCENT_APPID=
TENCENT_SECRET_KEY=
TENCENT_ENABLED=false

# DeepSeek 大模型情感分析（OpenAI 兼容；推荐中文通道，platform.deepseek.com 申请 Key）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_ENABLED=false

# 监听地址
HOST=0.0.0.0
PORT=8000
